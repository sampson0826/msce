{
  "manifest_version": 3,
  "name": "MSCE — Cross-Validation Detector for arXiv",
  "version": "0.1.0",
  "description": "Detect hidden cross-validation inconsistencies in cosmology papers on arXiv.",
  "author": "MSCE Collaboration",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://arxiv.org/abs/*"],
  "content_scripts": [
    {
      "matches": ["https://arxiv.org/abs/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MSCE"
  }
}
